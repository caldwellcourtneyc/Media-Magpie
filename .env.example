# Copy to .env.local for local use, or set these in your host's environment settings.
# `npm run dev` creates .env.local with a random APP_PASSWORD if you have none.

# Required. The one password for the sign-in screen. With it unset, the app stays locked.
APP_PASSWORD=

# Optional. A Postgres connection string (Neon, Supabase, your own server).
# Leave it unset to use the embedded database, which keeps its files in ./data/db.
# (POSTGRES_URL works too, as some hosts name it.)
DATABASE_URL=

# Optional. Lets scripts or a voice assistant call /api/* with
# "Authorization: Bearer <token>". At least 16 characters. Unset = API is browser-only.
API_TOKEN=

# Optional. A key for a movie metadata service (TMDB today). Unset = movie lookup
# uses Wikipedia, which needs no key.
MOVIE_API_KEY=

# Optional. `off` stops the server asking TVmaze for TV air dates (Coming soon then stays empty).
# AIR_DATES=off

# Optional. `1` marks a copy that isn't the real library (say, a laptop once the hosted
# copy is real) with a "Test copy" strip on every page.
# TEST_COPY=1

# Optional, dev only. Comma-separated host names or addresses allowed to open `npm run dev`
# from another device (a phone over Tailscale, say).
# DEV_ORIGINS=

# Optional, for `npm run backup:pull` and other scripts that talk to a running copy:
# its address, its API_TOKEN, and where pulled backups go (else BACKUP_DIR).
# MEDIA_LOG_URL=https://your-copy.example.com
# MEDIA_LOG_TOKEN=
# MEDIA_LOG_BACKUP_DIR=
# A command run when backup:pull fails, given a title and a message as its last two arguments.
# BACKUP_ALERT_CMD=

# Optional, local only. Where the embedded database and its backups live.
# LOCAL_DB_DIR=./data/db
# BACKUP_DIR=./data/backups
# LOCAL_BACKUPS=off
# A fresh database starts empty unless SEED_FILE names an export file (seed/demo.json is the demo).
# SEED_FILE=seed/demo.json
